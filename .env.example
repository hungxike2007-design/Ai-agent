# ====================================================
# FILE .env.example - MẪU CẤU HÌNH MÔI TRƯỜNG
# ====================================================
# Hướng dẫn:
#   1. Sao chép file này thành file .env
#   2. Điền giá trị thực vào các biến bên dưới
#   3. KHÔNG commit file .env lên GitHub!

# --- Flask ---
FLASK_SECRET_KEY=your_random_secret_key_here

# --- SQL Server ---
DB_SERVER=YOUR_SERVER_NAME
DB_NAME=QuanLyAIAgent
DB_TRUSTED_CONNECTION=yes

# --- Gemini API Keys (phân cách bằng dấu phẩy) ---
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2
GEMINI_MODEL_NAME=gemini-flash-latest

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
